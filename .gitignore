.DS_Store
**/.DS_Store
Thumbs.db

# Research repos (managed separately)
Research/unitree-vla/

# TechMedix (managed separately, has own .gitignore)
TechMedix-standalone/node_modules/
TechMedix-standalone/.next/
TechMedix-standalone/.env.local
TechMedix-standalone/.env*.local

# Legal / private docs
Legal/

# Python bytecode
**/__pycache__/
*.pyc
*.pyo

# Nested git repos (use submodules intentionally if needed)
bcr-live/
.vercel
.hermes/

# Claude workspace clutter
.claude/

# Domain research folders
BCR.HMTL Domain/

# Misc assets
*.png
RESEARCH_CAD_SOURCES.md

# Allow platform images for TechMedix cards
!TechMedix-standalone/public/images/platforms/*.png
# Allow PWA icons (required for production build)
!TechMedix-standalone/public/icons/*.png
!TechMedix-standalone/public/apple-touch-icon.png
# Allow the social share / Open Graph image (referenced by index.html og:image;
# without this the blanket *.png rule above leaves it untracked and it 404s live)
!TechMedix-standalone/public/og-techmedix.png
.env*
# Allow env example files (no secrets) so newcomers can clone-and-run
!.env.example
!TechMedix-standalone/.env.example

# Supabase CLI machine-local state (.temp/ holds the linked project ref, pooler
# URL, and cached version stamps). It is rewritten on every CLI invocation, so
# tracking it left the working tree permanently dirty and risked committing a
# connection string. Untracked 2026-10-03.
TechMedix-standalone/supabase/.temp/
