# Copy this file to .env.local and fill in your keys.
# Docs: TechMedix-standalone/README.md

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ATLAS_API_KEY=
ATLAS_BASE_URL=https://api.humanoidatlas.com

# Stripe (aftermarket store — real checkout)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://blackcatrobotics.com
# Optional: VLA behavioral comparator (Layer 2 of diagnostic pipeline)
# When set, the VLA comparator calls this local server instead of mock.
# Your friend's local model should accept POST { observation, language_instruction }
# and return { action_chunk: { chunk: number[][], inference_latency_ms: number } }.
VLA_INFERENCE_SERVER_URL=http://localhost:8080/predict
# VLA_MODEL_TYPE: "ee" (23-dim end-effector space) or "joint" (16-dim joint space)
VLA_MODEL_TYPE=ee
# Escalation threshold: behavioral score above this triggers Layer 3 AI analysis
VLA_ESCALATION_THRESHOLD=0.65

